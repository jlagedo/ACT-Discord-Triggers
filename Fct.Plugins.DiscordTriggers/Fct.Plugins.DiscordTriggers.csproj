<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Native FFXIV Combat Tracker plugin: wires ACT_DiscordTriggers.Core into the host's IPlugin
    contract and routes audio through a terminal IAudioSink. Loaded by the host into its own
    collectible AssemblyLoadContext.

    net10.0-windows (not plain net10) because it ProjectReferences the net10-windows Core, whose
    System.Speech synth path is Windows-only. The assembly name MUST stay Fct.Plugins.DiscordTriggers:
    Core's [InternalsVisibleTo("Fct.Plugins.DiscordTriggers")] is what lets DiscordAudioSink reach
    the internal SpeakTextCoreAsync/SpeakFileCoreAsync cores.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <IsPackable>false</IsPackable>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <!-- Emits the .deps.json the host's per-plugin AssemblyDependencyResolver needs. -->
    <EnableDynamicLoading>true</EnableDynamicLoading>
    <!-- The config UI is .axaml with x:DataType compiled bindings, matching the host's own views. -->
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <AssemblyVersion>2.1.2.0</AssemblyVersion>
    <FileVersion>2.1.2.0</FileVersion>
    <Version>2.1.2</Version>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\ACT_DiscordTriggers.Core\ACT_DiscordTriggers.Core.csproj" />
  </ItemGroup>

  <!-- The test project exercises the internal DiscordAudioSink directly. -->
  <ItemGroup>
    <InternalsVisibleTo Include="ACT_DiscordTriggers.Tests" />
  </ItemGroup>

  <!-- Host plugin contract, from the host's local nupkg feed (nuget.config -> fct-local; the host
       publishes no public NuGet feed). ExcludeAssets=runtime is the Private=false equivalent: the
       host loader shares these into the default ALC for single type identity across shell + plugin,
       so the plugin must NOT ship its own private copy. See libs/fct/README.md.

       The contract surface also leaks Avalonia types (UiSurface.CreateView returns a Control) and
       MEL types (IPluginHost.Logger is an ILogger) — pulled in transitively by these packages. They
       are declared explicitly with ExcludeAssets=runtime so the direct reference overrides the
       transitive runtime flow and keeps those host-provided assemblies out of the plugin output. -->
  <ItemGroup>
    <PackageReference Include="Fct.Abstractions" Version="1.0.0" ExcludeAssets="runtime" />
    <PackageReference Include="Fct.Abstractions.UI" Version="1.0.0" ExcludeAssets="runtime" />
    <PackageReference Include="Avalonia" Version="12.0.5" ExcludeAssets="runtime" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.9" ExcludeAssets="runtime" />
  </ItemGroup>

  <ItemGroup>
    <None Include="plugin.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- Avalonia assets (embedded as avares:// resources): the mascot logo, linked from docs/ so the
       1.3 MB PNG isn't duplicated in the repo. The avares path follows the Link, i.e.
       avares://Fct.Plugins.DiscordTriggers/Assets/logo.png. .axaml files are auto-globbed as
       AvaloniaXaml by the Avalonia build targets. -->
  <ItemGroup>
    <AvaloniaResource Include="..\docs\logo.png" Link="Assets\logo.png" />
  </ItemGroup>

  <!-- Stage the node bridge (node.exe + bundle.js + node_modules/) next to the plugin DLL so
       FindBridgeDir resolves "next to the DLL" in dev. Gated on the bridge dist existing — build it
       first (build.ps1 or `npm run bundle` in DiscordBridge-node). Runtime logs are excluded. Full
       release packaging into the host's plugins/ dir is a later phase. -->
  <Target Name="StageDiscordBridge" AfterTargets="Build"
          Condition="Exists('$(MSBuildProjectDirectory)\..\DiscordBridge-node\dist\bundle.js')">
    <ItemGroup>
      <BridgeFiles Include="$(MSBuildProjectDirectory)\..\DiscordBridge-node\dist\**\*"
                   Exclude="$(MSBuildProjectDirectory)\..\DiscordBridge-node\dist\DiscordBridge.log;$(MSBuildProjectDirectory)\..\DiscordBridge-node\dist\selftest.stdout" />
    </ItemGroup>
    <Copy SourceFiles="@(BridgeFiles)"
          DestinationFiles="@(BridgeFiles->'$(OutDir)%(RecursiveDir)%(Filename)%(Extension)')"
          SkipUnchangedFiles="true" />
    <Message Importance="high" Text="Staged Discord bridge into $(OutDir)" />
  </Target>

</Project>
