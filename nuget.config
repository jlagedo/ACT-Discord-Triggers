<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <!-- Host plugin-contract packages (Fct.Abstractions[.UI]). The host publishes no public
         feed; it emits these nupkgs into dist/debug/packages. Both repos are cloned side-by-side
         under E:\dev, so the source is relative to this file. Refresh: rebuild the host's package
         target, then `dotnet restore` here. See libs/fct/README.md. -->
    <add key="fct-local" value="..\ffxiv-combat-tracker\dist\debug\packages" />
    <!-- Vendored fallback of the same contract packages, committed under libs/fct/packages so
         CI (and any bare checkout) restores the modern plugin without the sibling host repo.
         fct-local wins when a live host build is present; NuGet falls back here otherwise.
         Refresh with tools/vendor-fct-packages.ps1. -->
    <add key="fct-vendored" value="libs\fct\packages" />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </packageSources>
</configuration>
