<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <!-- Both TFMs run under `dotnet test`: net48 covers the shared Core on the legacy
         ACT path, net10.0-windows adds the FCT plugin's DiscordAudioSink seam. -->
    <TargetFrameworks>net48;net10.0-windows</TargetFrameworks>
    <IsPackable>false</IsPackable>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <!-- xunit v3 test projects are executables, run via the VSTest adapter below. -->
    <OutputType>Exe</OutputType>
  </PropertyGroup>
  <ItemGroup>
    <!-- xunit v3 + Microsoft.NET.Test.Sdk + xunit.runner.visualstudio 3.x run the
         tests under VSTest (`dotnet test`) on modern .NET. -->
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.9.0" />
    <PackageReference Include="xunit.v3" Version="3.2.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.5">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>
  <ItemGroup>
    <None Include="xunit.runner.json" CopyToOutputDirectory="PreserveNewest" />
    <!-- The production code under test (Protocol/Settings/Ipc/ViewModels) lives in Core,
         which flows its System.Text.Json + CommunityToolkit.Mvvm deps through transitively.
         Core's InternalsVisibleTo grants access to the internal members the tests use
         (DiagnosticsLog.MergeInterleave, the internal PipeClient/BridgeProcess types). -->
    <ProjectReference Include="..\ACT_DiscordTriggers.Core\ACT_DiscordTriggers.Core.csproj" />
  </ItemGroup>
  <!-- The native plugin (DiscordAudioSink terminal-sink seam) is net10-only: it pulls
       Avalonia + the FCT host contracts that don't exist on net48. Its DiscordAudioSinkTests
       is excluded from the net48 pass below. The plugin PackageReferences the contracts with
       ExcludeAssets=runtime (host-provided), so the test supplies Fct.Abstractions itself to
       get the runtime DLL the sink binds to. -->
  <ItemGroup Condition="'$(TargetFramework)' == 'net10.0-windows'">
    <ProjectReference Include="..\Fct.Plugins.DiscordTriggers\Fct.Plugins.DiscordTriggers.csproj" />
    <PackageReference Include="Fct.Abstractions" Version="1.0.0" />
  </ItemGroup>
  <ItemGroup Condition="'$(TargetFramework)' == 'net48'">
    <Compile Remove="DiscordAudioSinkTests.cs" />
  </ItemGroup>
</Project>
